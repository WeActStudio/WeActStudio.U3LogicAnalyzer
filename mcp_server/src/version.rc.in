/*
 * Windows version resource for u3logicanalyzer-mcp-server, generated by CMake
 * from version.rc.in: the numbers come from the project version, which in turn
 * comes from pulseview/CMakeLists.txt.
 *
 * Without this resource the file properties of the executable are blank, and
 * the provenance of the binary - which project it belongs to and that its
 * protocol follows an MIT licensed upstream - is nowhere in the file.
 */
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "WeAct Studio"
            VALUE "FileDescription", "U3LogicAnalyzer MCP server"
            VALUE "FileVersion", "@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@.0"
            VALUE "InternalName", "u3logicanalyzer-mcp-server"
            VALUE "LegalCopyright", "Copyright (C) 2026 WeAct Studio. GPL-3.0-or-later"
            VALUE "Comments", "stdio MCP server driving u3logicanalyzer-cli; protocol follows KenosInc/sigrok-mcp-server (MIT)"
            VALUE "OriginalFilename", "u3logicanalyzer-mcp-server.exe"
            VALUE "ProductName", "WeAct Studio U3LogicAnalyzer"
            VALUE "ProductVersion", "@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
